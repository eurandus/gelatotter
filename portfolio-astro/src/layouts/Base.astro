---
import '../styles/global.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  /** path to a 1200x630 image in /public, used for link previews */
  ogImage?: string;
}

const {
  title = 'Germaine Chin — Product Manager',
  description = 'Product Manager building AI and fintech products in regulated markets. Cognitive Science background, human-centered design, Singapore.',
  ogImage = '/og.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Germaine Chin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="theme-color" content="#faf6f0" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,500;1,9..144,700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="nav">
      <a href="/#top" class="brand">Germaine Chin</a>
      <nav>
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        <a href="/#experience">Experience</a>
        <a href="/#sss">Germ's SDLC</a>
        <a href="/#resume">Resume</a>
      </nav>
      <button id="motionToggle" class="pill" aria-pressed="false">Pause motion</button>
    </header>

    <slot />

    <footer class="foot">© <span id="yr"></span> Germaine Chin 🦦</footer>
  </body>
</html>
